            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "version" ]
      },
      "StoredDocument" : {
        "type" : "object",
        "properties" : {
          "contentType" : {
            "type" : "string"
          },
          "fileName" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "sha256" : {
            "type" : "string"
          },
          "sizeBytes" : {
            "type" : "integer",
            "format" : "int64"
          },
          "uploadedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "uploadedBy" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "contentType", "fileName", "id", "sha256", "sizeBytes", "uploadedAt", "uploadedBy" ]
      },
      "SubmitClaimRequest" : {
        "type" : "object",
        "properties" : {
          "amountClaimed" : {
            "type" : "number"
          },
          "claimType" : {
            "type" : "string",
            "enum" : [ "FLIGHT_DELAY", "BAGGAGE_DELAYED", "LOST_OR_DAMAGED_BAGGAGE", "TRIP_CANCELLATION" ]
          },
          "description" : {
            "type" : "string",
            "nullable" : true
          },
          "incidentDate" : {
            "type" : "string",
            "format" : "date"
          },
          "policyId" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "amountClaimed", "claimType", "incidentDate", "policyId" ]
      },
      "TimelineEntry" : {
        "type" : "object",
        "properties" : {
          "actorId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "fromStatus" : {
            "type" : "string",
            "nullable" : true,
            "enum" : [ "SUBMITTED", "UNDER_REVIEW", "MORE_INFO_NEEDED", "APPROVED", "REJECTED" ]
          },
          "message" : {
            "type" : "string",
            "nullable" : true
          },
          "occurredAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "toStatus" : {
            "type" : "string",
            "enum" : [ "SUBMITTED", "UNDER_REVIEW", "MORE_INFO_NEEDED", "APPROVED", "REJECTED" ]
          }
        },
        "required" : [ "actorId", "occurredAt", "toStatus" ]
      }
