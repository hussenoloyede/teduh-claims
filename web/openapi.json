          "in" : "query",
          "name" : "tab",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ClaimSummary"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "claim-controller" ]
      },
      "post" : {
        "operationId" : "submit",
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "type" : "object",
                "properties" : {
                  "claim" : {
                    "$ref" : "#/components/schemas/SubmitClaimRequest"
                  },
                  "files" : {
                    "type" : "array",
                    "items" : {
                      "type" : "string",
                      "format" : "binary"
                    }
                  }
                },
                "required" : [ "claim" ]
              }
            }
          }
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClaimDetails"
                }
              }
            },
            "description" : "The new claim, with its reference"
          }
        },
        "tags" : [ "claim-controller" ]
      }
    },
