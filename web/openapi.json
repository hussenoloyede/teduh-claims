  "components" : {
    "schemas" : {
      "ApproveRequest" : {
        "type" : "object",
        "properties" : {
          "amount" : {
            "type" : "number"
          },
          "reason" : {
            "type" : "string",
            "nullable" : true
          },
          "version" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "amount", "version" ]
      },
      "ClaimDetails" : {
        "type" : "object",
        "properties" : {
          "amountClaimed" : {
            "type" : "number"
          },
          "approvedAmount" : {
            "type" : "number",
            "nullable" : true
          },
          "assignedAgentId" : {
            "type" : "string",
            "format" : "uuid",
            "nullable" : true
          },
          "claimType" : {
            "type" : "string",
            "enum" : [ "FLIGHT_DELAY", "BAGGAGE_DELAYED", "LOST_OR_DAMAGED_BAGGAGE", "TRIP_CANCELLATION" ]
          },
          "decisionReason" : {
            "type" : "string",
            "nullable" : true
          },
          "description" : {
            "type" : "string"
          },
          "documents" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/StoredDocument"
            }
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "incidentDate" : {
            "type" : "string",
            "format" : "date"
          },
          "policyId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "reference" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "SUBMITTED", "UNDER_REVIEW", "MORE_INFO_NEEDED", "APPROVED", "REJECTED" ]
          },
          "submittedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "timeline" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/TimelineEntry"
            }
          },
          "version" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "amountClaimed", "claimType", "description", "documents", "id", "incidentDate", "policyId", "reference", "status", "submittedAt", "timeline", "version" ]
      },
      "ClaimSummary" : {
        "type" : "object",
        "properties" : {
          "amountClaimed" : {
            "type" : "number"
          },
          "assignedAgentId" : {
            "type" : "string",
            "format" : "uuid",
            "nullable" : true
          },
          "claimType" : {
            "type" : "string",
            "enum" : [ "FLIGHT_DELAY", "BAGGAGE_DELAYED", "LOST_OR_DAMAGED_BAGGAGE", "TRIP_CANCELLATION" ]
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "reference" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "SUBMITTED", "UNDER_REVIEW", "MORE_INFO_NEEDED", "APPROVED", "REJECTED" ]
          },
          "submittedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "version" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "amountClaimed", "claimType", "id", "reference", "status", "submittedAt", "version" ]
      },
      "DownloadLink" : {
        "type" : "object",
        "properties" : {
          "expiresAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "url" : {
            "type" : "string"
          }
        },
        "required" : [ "expiresAt", "url" ]
      },
      "Inbox" : {
        "type" : "object",
        "properties" : {
          "notifications" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Item"
            }
          },
          "unreadCount" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "notifications", "unreadCount" ]
      },
      "Item" : {
        "type" : "object",
        "properties" : {
          "claimId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "message" : {
            "type" : "string"
          },
          "read" : {
            "type" : "boolean"
          }
        },
        "required" : [ "claimId", "createdAt", "id", "message", "read" ]
      },
      "Me" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "CUSTOMER", "AGENT" ]
          }
        },
        "required" : [ "displayName", "email", "id", "role" ]
      },
      "PolicyCover" : {
        "type" : "object",
        "properties" : {
          "coverEnd" : {
            "type" : "string",
            "format" : "date"
          },
          "coverStart" : {
            "type" : "string",
            "format" : "date"
          },
          "customerId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "limits" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "number"
            }
          },
          "planName" : {
            "type" : "string"
          },
          "policyId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "policyNumber" : {
            "type" : "string"
          }
        },
        "required" : [ "coverEnd", "coverStart", "customerId", "limits", "planName", "policyId", "policyNumber" ]
      },
      "RejectRequest" : {
        "type" : "object",
        "properties" : {
          "reason" : {
            "type" : "string",
            "nullable" : true
          },
          "version" : {
